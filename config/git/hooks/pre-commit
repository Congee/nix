#!/usr/bin/env bash

# An hook script to remove trailing whitespaces to be committed.

if git rev-parse --verify HEAD >/dev/null 2>&1
then
    against=HEAD
else
    # Initial commit: diff against an empty tree object
    against=$(git hash-object -t tree /dev/null)
fi

# Fix files with trailing whitespace, then restage them.
git diff-index --check --cached "$against" -- \
    | sed -e '/^[+-]/d' -e 's/:[0-9][0-9]*:.*$//' \
    | sort -u \
    | while IFS= read -r file; do
        # [[:blank:]], not [[:space:]]: stripping \r corrupts CRLF files (.ics).
        # No sed -i: GNU wants -i, BSD wants -i ''. cat keeps mode and inode.
        tmp=$(mktemp) || exit 1
        sed 's/[[:blank:]]*$//' "$file" > "$tmp" && cat "$tmp" > "$file"
        rm -f "$tmp"
        git add "$file"
    done

set -eu
hook_name="$(basename "$0")"
hook_script=".git/hooks/$hook_name"
[ -e "$hook_script" ] && "$hook_script"
exit 0
