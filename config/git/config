[push]
    default = simple
    followtags = true
[fetch]
    all = true
    prune = true
[advice]
    skippedcherrypicks = true
[alias]
    exec = ! exec  ;  shell aliases are always executed in the top-level directory
    aliases = config --get-regexp alias
    tree = log --graph --decorate --pretty=oneline --abbrev-commit --boundary
    co = checkout
    meh = ! env GIT_AUTHOR_DATE='$(git log --no-walk --format=%ad)' git commit --amend --no-edit
    who = shortlog -sn
    # test $c guards a cancelled fzf: empty would fall through to --root and replay everything
    frebase = !"c=$(git log --pretty=oneline --decorate --abbrev-commit | fzf | cut -d ' ' -f1) && test $c && git rebase --committer-date-is-author-date --interactive $(git rev-parse -q --verify $c^ || echo --root) #"
    lg = log --all --color --graph --pretty=format:"%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset" --abbrev-commit
    cmp = log --left-right --graph --oneline --cherry
    cp = cherry-pick
    # not `branch -v | grep [gone]`: that also matches a commit subject containing [gone]
    prunelocal = !"git for-each-ref --format='%(refname:short) %(upstream:track,nobracket)' refs/heads | awk '$2 ~ /^gone$/ { print $1 }' | xargs --no-run-if-empty git branch -D"
    # resolve the rev up front; HEAD moves after --fixup, so a bare $1~1 lands one commit too shallow
    # $c~1 is invalid for a root commit, hence the --root fallback
    fixup = !"c=$(git rev-parse $1) && git commit --fixup=$c && git rebase --committer-date-is-author-date --autostash --autosquash --rebase-merges $(git rev-parse -q --verify $c~1 || echo --root) #"
[rerere]
    enabled = true
    autoupdate = true
[merge]
    tool = vimdiff
    ff = true
    conflictstyle = zdiff3
[pull]
    ff = true
[mergetool]
    prompt = true
[mergetool "vimdiff"]
    cmd = nvim -d $BASE $LOCAL $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'
[color]
    diff = auto
    ui = false
[difftool]
    prompt = true
[diff]
    tool = vimdiff
    mnemonicprefix = true
    colormoved = true
    renames = true
    algorithm = histogram
[delta]
    features = villsau  # theme of unified view. use "chameleon" for split view
[tag]
    sort = version:refname
[core]
    hooksPath = ~/.config/git/hooks
    trustctime = false
    ; attributesfile = ~/.gitattributes
    # pager = delta --dark
[rebase]
    updaterefs = true
[gpg]
    format = ssh
[gpg "ssh"]
    allowedSignersFile = ~/.ssh/allowed_signers
[commit]
    gpgsign = true
    verbose = true
[cola]
    spellcheck = false
[filter "lfs"]
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f
[filter "remove-trailing-whitespace"]
    ; https://git-scm.com/docs/git-config#Documentation/git-config.txt-filterltdrivergtclean
    clean = "[[ ( -d $(git rev-parse --git-path rebase-merge) ) || ( -d $(git rev-parse --git-path rebase-apply) ) ]] && cat || sed -e's| \\+$||' "
    smudge = cat
    required = true
[sequence]
    # editor = interactive-rebase-tool
[credential]
    helper = store
[hub]
    protocol = ssh
[init]
    defaultBranch = master
[include]
    path = ./themes.gitconfig  # delta diff tool themes
    path = ~/.config/git/config.user  # name, email, signingkey

